#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x62f3aa182c30 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x62f3aa182dc0 .scope module, "testbench" "testbench" 3 1;
 .timescale 0 0;
v0x62f3aa1942e0_0 .var "a", 0 0;
v0x62f3aa1943a0_0 .var "b", 0 0;
v0x62f3aa194470_0 .net "c", 0 0, L_0x62f3aa194640;  1 drivers
v0x62f3aa194570_0 .var "sel", 0 0;
S_0x62f3aa149490 .scope module, "DUT" "mux" 3 8, 4 1 0, S_0x62f3aa182dc0;
 .timescale 0 0;
    .port_info 0 /INPUT 1 "a";
    .port_info 1 /INPUT 1 "b";
    .port_info 2 /INPUT 1 "sel";
    .port_info 3 /OUTPUT 1 "c";
v0x62f3aa149620_0 .net "a", 0 0, v0x62f3aa1942e0_0;  1 drivers
v0x62f3aa193fe0_0 .net "b", 0 0, v0x62f3aa1943a0_0;  1 drivers
v0x62f3aa1940a0_0 .net "c", 0 0, L_0x62f3aa194640;  alias, 1 drivers
v0x62f3aa194170_0 .net "sel", 0 0, v0x62f3aa194570_0;  1 drivers
L_0x62f3aa194640 .functor MUXZ 1, v0x62f3aa1942e0_0, v0x62f3aa1943a0_0, v0x62f3aa194570_0, C4<>;
    .scope S_0x62f3aa182dc0;
T_0 ;
    %vpi_call/w 3 16 "$dumpfile", "dump.vcd" {0 0 0};
    %vpi_call/w 3 17 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x62f3aa182dc0 {0 0 0};
    %pushi/vec4 0, 0, 1;
    %store/vec4 v0x62f3aa1942e0_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x62f3aa1943a0_0, 0, 1;
    %pushi/vec4 1, 0, 1;
    %store/vec4 v0x62f3aa194570_0, 0, 1;
    %delay 20, 0;
    %load/vec4 v0x62f3aa194470_0;
    %pad/u 32;
    %cmpi/ne 1, 0, 32;
    %jmp/0xz  T_0.0, 6;
    %vpi_call/w 3 23 "$error", "BAD" {0 0 0};
T_0.0 ;
    %vpi_call/w 3 24 "$dumpflush" {0 0 0};
    %vpi_call/w 3 25 "$finish" {0 0 0};
    %end;
    .thread T_0;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "testbench.sv";
    "mux.sv";
