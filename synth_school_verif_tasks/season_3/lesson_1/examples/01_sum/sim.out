#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision + 0;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x55ac27b2adf0 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x55ac27b2af80 .scope module, "testbench" "testbench" 3 1;
 .timescale 0 0;
v0x55ac27b3c1a0_0 .var "A", 7 0;
v0x55ac27b3c290_0 .var "B", 7 0;
v0x55ac27b3c360_0 .net "C", 7 0, L_0x55ac27b3c460;  1 drivers
S_0x55ac27af1490 .scope module, "DUT" "sum" 3 7, 4 1 0, S_0x55ac27b2af80;
 .timescale 0 0;
    .port_info 0 /INPUT 8 "a";
    .port_info 1 /INPUT 8 "b";
    .port_info 2 /OUTPUT 8 "c";
v0x55ac27af16c0_0 .net "a", 7 0, v0x55ac27b3c1a0_0;  1 drivers
v0x55ac27b3bf80_0 .net "b", 7 0, v0x55ac27b3c290_0;  1 drivers
v0x55ac27b3c060_0 .net "c", 7 0, L_0x55ac27b3c460;  alias, 1 drivers
L_0x55ac27b3c460 .arith/sum 8, v0x55ac27b3c1a0_0, v0x55ac27b3c290_0;
    .scope S_0x55ac27b2af80;
T_0 ;
    %vpi_call/w 3 14 "$dumpfile", "dump.vcd" {0 0 0};
    %vpi_call/w 3 15 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x55ac27b2af80 {0 0 0};
    %pushi/vec4 2, 0, 8;
    %store/vec4 v0x55ac27b3c1a0_0, 0, 8;
    %pushi/vec4 3, 0, 8;
    %store/vec4 v0x55ac27b3c290_0, 0, 8;
    %delay 20, 0;
    %load/vec4 v0x55ac27b3c360_0;
    %pad/u 32;
    %cmpi/ne 5, 0, 32;
    %jmp/0xz  T_0.0, 6;
    %vpi_call/w 3 20 "$error", "BAD" {0 0 0};
T_0.0 ;
    %vpi_call/w 3 21 "$dumpflush" {0 0 0};
    %vpi_call/w 3 22 "$finish" {0 0 0};
    %end;
    .thread T_0;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "testbench.sv";
    "sum.sv";
