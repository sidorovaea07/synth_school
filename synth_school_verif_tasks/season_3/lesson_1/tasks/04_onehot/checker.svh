// Объявляем событие окончания
event gen_done;

// Предположим, что разрядность вашего сигнала bin равна 8 битам (измените, если у вас 4 или 16)
// Этот массив будет хранить флаги: был ли активирован конкретный бит
reg [7:0] covered_bits; 

// Логика отслеживания сигнала bin
initial begin
    fork
        // Постоянно следим за изменением сигнала bin (аналог сэмплирования по изменению @(bin))
        forever begin
            @(bin); // Как только сигнал bin изменился
            
            // Проверяем каждый бит: если он равен 1, помечаем его как покрытый
            for (int i = 0; i < 64; i++) begin
                if (bin[i] == 1'b1) begin
                    covered_bits[i] = 1'b1;
                end
            end
        end

        // Ждем сигнала окончания работы из основного тестбенча
        @(gen_done); 
    join_any

    // Блок вывода ручного отчета (исправлен синтаксис для iverilog)
    begin: report_block
        int count;
        real score;
        
        count = 0;
        // Считаем, сколько всего уникальных бит мы успели зажечь в процессе теста
        for (int i = 0; i < 8; i++) begin
            if (covered_bits[i] == 1'b1) count++;
        end

        // Вычисляем процент покрытия (для 8-битного сигнала)
        score = (count / 8.0) * 100.0;

        // Выводим красивую статистику прямо в терминал VS Code!
        $display("========================================");
        $display("   РУЧНОЙ ОТЧЕТ ПО ПОКРЫТИЮ (ONE-HOT)   ");
        $display("========================================");
        $display("Сигнал bin покрыт на: %3.1f%% (%0d из 8 бит)", score, count);
        $display("========================================");
    end
end
