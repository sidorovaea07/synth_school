#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x56a2db21c790 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x56a2db22dc30 .scope module, "testbench" "testbench" 3 3;
 .timescale -9 -12;
v0x56a2db241880_0 .var "a", 7 0;
v0x56a2db241970_0 .var "b", 7 0;
v0x56a2db241a40_0 .net "c", 0 0, L_0x56a2db241b40;  1 drivers
S_0x56a2db22ddc0 .scope module, "DUT" "comp" 3 9, 4 1 0, S_0x56a2db22dc30;
 .timescale 0 0;
    .port_info 0 /INPUT 8 "a";
    .port_info 1 /INPUT 8 "b";
    .port_info 2 /OUTPUT 1 "c";
v0x56a2db21be10_0 .net "a", 7 0, v0x56a2db241880_0;  1 drivers
v0x56a2db241680_0 .net "b", 7 0, v0x56a2db241970_0;  1 drivers
v0x56a2db241760_0 .net "c", 0 0, L_0x56a2db241b40;  alias, 1 drivers
L_0x56a2db241b40 .cmp/gt 8, v0x56a2db241880_0, v0x56a2db241970_0;
    .scope S_0x56a2db22dc30;
T_0 ;
    %pushi/vec4 10, 0, 8;
    %store/vec4 v0x56a2db241880_0, 0, 8;
    %pushi/vec4 10, 0, 8;
    %store/vec4 v0x56a2db241970_0, 0, 8;
    %delay 10000, 0;
    %load/vec4 v0x56a2db241a40_0;
    %pad/u 32;
    %cmpi/e 0, 0, 32;
    %jmp/0xz  T_0.0, 6;
    %jmp T_0.1;
T_0.0 ;
    %vpi_call/w 3 34 "$error", "FAIL: 10ns: a=10, b=10, expected c=0, got c=%d", v0x56a2db241a40_0 {0 0 0};
T_0.1 ;
    %pushi/vec4 30, 0, 8;
    %store/vec4 v0x56a2db241880_0, 0, 8;
    %pushi/vec4 20, 0, 8;
    %store/vec4 v0x56a2db241970_0, 0, 8;
    %delay 20000, 0;
    %load/vec4 v0x56a2db241a40_0;
    %pad/u 32;
    %cmpi/e 1, 0, 32;
    %jmp/0xz  T_0.2, 6;
    %jmp T_0.3;
T_0.2 ;
    %vpi_call/w 3 40 "$error", "FAIL: 30ns: a=30, b=20, expected c=1, got c=%d", v0x56a2db241a40_0 {0 0 0};
T_0.3 ;
    %pushi/vec4 40, 0, 8;
    %store/vec4 v0x56a2db241970_0, 0, 8;
    %delay 10000, 0;
    %load/vec4 v0x56a2db241a40_0;
    %pad/u 32;
    %cmpi/e 0, 0, 32;
    %jmp/0xz  T_0.4, 6;
    %jmp T_0.5;
T_0.4 ;
    %vpi_call/w 3 45 "$error", "FAIL: 40ns: a=30, b=40, expected c=0, got c=%d", v0x56a2db241a40_0 {0 0 0};
T_0.5 ;
    %vpi_call/w 3 47 "$display", "PASS: All checks passed!" {0 0 0};
    %vpi_call/w 3 48 "$finish" {0 0 0};
    %end;
    .thread T_0;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "testbench.sv";
    "comp.sv";
